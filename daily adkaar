function add(it,k){state[it.id]=Math.max(0,(state[it.id]||0)+k);save();render()}

function render(){
  var sum=0,gsum=0;
  ITEMS.forEach(function(it){
    var v=state[it.id]||0,g=goalOf(it);sum+=v;gsum+=g;
    var d=document.getElementById("i-"+it.id);
    d.classList.toggle("done",v>=g);
    d.querySelector(".cnt").textContent=(v>=g?"✓ ":"")+v.toLocaleString()+" / "+g.toLocaleString();
    d.querySelector(".bar i").style.width=Math.min(100,v/g*100)+"%";
  });
  
  var quranBox = document.getElementById("quran-box");
  var quranBtn = document.getElementById("quran-toggle-btn");
  if(state.quranRead){
    quranBox.classList.add("done");
    quranBtn.textContent = "La Aqriyey ✓";
  } else {
    quranBox.classList.remove("done");
    quranBtn.textContent = "Ma Aqriyay ❌";
  }

  var sF = state.sunnahFajr;
  document.getElementById("btn-sunnah-yes").setAttribute("aria-pressed", sF === "yes" ? "true" : "false");
  document.getElementById("btn-sunnah-no").setAttribute("aria-pressed", sF === "no" ? "true" : "false");

  var bH = state.badHabit;
  document.getElementById("btn-bad-yes").setAttribute("aria-pressed", bH === "yes" ? "true" : "false");
  document.getElementById("btn-bad-no").setAttribute("aria-pressed", bH === "no" ? "true" : "false");

  var pst=state.prayers||{};
  PR.forEach(function(p){
    [].forEach.call(document.querySelectorAll("#p-"+p.id+" .pbtn"),function(b){
      b.setAttribute("aria-pressed",pst[p.id]===b.dataset.v?"true":"false");
    });
  });

  document.getElementById("tot").textContent=sum.toLocaleString();
  document.getElementById("totgoal").textContent=gsum.toLocaleString();
  document.getElementById("totbar").style.width=Math.min(100,sum/gsum*100)+"%";
  renderWeek();
  renderHist();
}

