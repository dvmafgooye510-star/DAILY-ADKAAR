<!DOCTYPE html>
<html lang="so">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#c95b7f">
<title>Adhkaar Maalinle ah</title>

<!-- Qalabka PWA (App Settings) -->
<link rel="manifest" href="manifest.json">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Adhkaar">
<link rel="apple-touch-icon" href="https://cdn-icons-png.flaticon.com/512/3655/3655589.png">

<style>
:root{--bg:#fbeef2;--card:#fff;--ink:#4a2a36;--rose:#c95b7f;--soft:#f7d3de;--line:#efc3d0;--ok:#3f8f6b;--bad:#d9534f;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#2a1a20;--card:#3a2530;--ink:#f6dfe6;--rose:#e58aa8;--soft:#4d2f3b;--line:#6a4050;--ok:#6fcf9f;--bad:#ff6b6b}}
:root[data-theme="dark"]{--bg:#2a1a20;--card:#3a2530;--ink:#f6dfe6;--rose:#e58aa8;--soft:#4d2f3b;--line:#6a4050;--ok:#6fcf9f;--bad:#ff6b6b}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Georgia,"Times New Roman",serif;line-height:1.5}
main{max-width:560px;margin:0 auto;padding:22px 14px 40px}
header{text-align:center}
h1{margin:0;font-size:1.9rem;color:var(--rose)}
.syncmsg{margin:-8px 0 12px;font-size:.78rem;opacity:.7;text-align:center}
#date{margin:2px 0 14px;font-style:italic;opacity:.8}
.total{background:var(--card);border:2px solid var(--line);border-radius:16px;padding:12px 14px;margin-bottom:16px}
.total b{color:var(--rose)}
.bar{height:10px;background:var(--soft);border-radius:6px;overflow:hidden;margin-top:8px}
.bar i{display:block;height:100%;width:0;background:var(--rose);transition:width .25s}
.item{background:var(--card);border:2px solid var(--line);border-radius:16px;padding:14px;margin-bottom:12px}
.item.done{border-color:var(--ok)}
.top{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.name{font-weight:bold;color:var(--rose);font-size:1.1rem}
.cnt{font-size:1.3rem;font-weight:bold}
.done .cnt{color:var(--ok)}
.ar{direction:rtl;font-size:1.2rem;line-height:1.9;margin:6px 0;font-family:"Amiri","Traditional Arabic","Noto Naskh Arabic",serif}
.time{font-size:.85rem;opacity:.75;margin-bottom:8px}
.goal{display:flex;align-items:center;gap:8px;margin:10px 0 0;font-size:.9rem}
.goal input{width:110px;font:inherit;padding:8px;border-radius:10px;border:2px solid var(--line);background:var(--bg);color:var(--ink);min-height:40px}
.row{display:flex;gap:8px;margin-top:10px}
button{font:inherit;border-radius:12px;border:2px solid var(--rose);background:var(--soft);color:var(--ink);padding:10px 12px;cursor:pointer;min-height:44px}
button.main{flex:1;background:var(--rose);color:#fff;font-weight:bold;font-size:1.05rem}
button:focus-visible,input:focus-visible{outline:3px solid var(--ink);outline-offset:2px}

/* Qaybta Qur'aanka */
.quran-card{background:var(--card);border:2px solid var(--line);border-radius:16px;padding:14px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center}
.quran-card.done{border-color:var(--ok)}
.quran-info h3{margin:0;color:var(--rose);font-size:1.1rem}
.quran-info p{margin:4px 0 0;font-size:.85rem;opacity:.75}
.quran-btn{background:var(--soft);border:2px solid var(--rose);color:var(--ink);font-weight:bold;padding:10px 16px;border-radius:12px;cursor:pointer;min-height:44px}
.quran-card.done .quran-btn{background:var(--ok);border-color:var(--ok);color:#fff}

/* Qaybaha Caadooyinka & Sunnada */
.yn-card{background:var(--card);border:2px solid var(--line);border-radius:16px;padding:14px;margin-bottom:12px}
.yn-card h3{margin:0;color:var(--rose);font-size:1.1rem}
.yn-row{display:flex;gap:10px;margin-top:10px}
.yn-btn{flex:1;font-size:1rem;font-weight:bold;padding:8px 12px}
.yn-btn.yes[aria-pressed="true"]{background:var(--ok);border-color:var(--ok);color:#fff}
.yn-btn.no[aria-pressed="true"]{background:var(--rose);border-color:var(--rose);color:#fff}
.bad-card .yn-btn.yes[aria-pressed="true"]{background:var(--bad);border-color:var(--bad);color:#fff}
.bad-card .yn-btn.no[aria-pressed="true"]{background:var(--ok);border-color:var(--ok);color:#fff}

.prayers-card{background:var(--card);border:2px solid var(--line);border-radius:16px;padding:14px;margin-bottom:12px}
.prayers-card h3{margin:0;color:var(--rose);font-size:1.1rem}
.prayers-card .q{margin:4px 0 6px;font-size:.85rem;opacity:.75}
.prayer{border-top:1px solid var(--line);padding:10px 0 4px}
.prayer:first-of-type{border-top:0}
.pname{display:flex;justify-content:space-between;align-items:center;gap:8px}
.pname .ar{margin:0;font-size:1.25rem}
.pname .so{font-size:.85rem;opacity:.75}
.prow{display:flex;gap:8px;margin-top:6px}
.pbtn{flex:1;font-size:.92rem;padding:8px 6px}
.pbtn[aria-pressed="true"].m{background:var(--ok);border-color:var(--ok);color:#fff;font-weight:bold}
.pbtn[aria-pressed="true"].n{background:var(--rose);border-color:var(--rose);color:#fff;font-weight:bold}
.week{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:10px}
.day{padding:6px 2px;min-height:78px;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:.72rem;border-radius:12px}
.day b{font-size:.95rem;color:var(--rose)}
.day.sel{background:var(--rose);color:#fff}
.day.sel b{color:#fff}
.day.fut{opacity:.4}
.day .mb{width:80%;height:5px;background:var(--line);border-radius:3px;overflow:hidden}
.day .mb i{display:block;height:100%;background:var(--ok)}
#wk{background:var(--card);border:2px solid var(--line);border-radius:14px;padding:6px 14px;margin-bottom:8px}
h2{color:var(--rose);font-size:1.3rem;margin:26px 0 4px}
#sum{margin:0 0 10px;font-size:.9rem;opacity:.8}
details{background:var(--card);border:2px solid var(--line);border-radius:14px;padding:10px 14px;margin-bottom:8px}
summary{cursor:pointer;display:flex;justify-content:space-between;gap:8px;font-weight:bold;min-height:32px}
summary b{color:var(--rose)}
.h{display:flex;justify-content:space-between;padding:6px 0;border-top:1px solid var(--line);font-size:.92rem}
.h.ok span:last-child{color:var(--ok);font-weight:bold}
.h.bad span:last-child{color:var(--bad);font-weight:bold}
.empty{opacity:.7;font-style:italic}
.reset{display:block;margin:18px auto 0;background:transparent;border-color:var(--line);font-size:.9rem}
</style>
</head>
<body>
<main>
<header>
<h1>Adhkaar Maalinle ah</h1>
<p id="date"></p>
<p class="syncmsg" id="syncmsg"></p>
</header>
<div class="total"><span>Maanta: <b id="tot">0</b> / <span id="totgoal">0</span></span><div class="bar"><i id="totbar"></i></div></div>

<!-- Qaybta gaarka ah ee Qur'aanka -->
<div class="quran-card" id="quran-box">
  <div class="quran-info">
    <h3>Qur'aanka Maanta</h3>
    <p>Ma la aqriyay Qur'aan maanta?</p>
  </div>
  <button class="quran-btn" id="quran-toggle-btn">Ma Aqriyay ❌</button>
</div>

<!-- رَكْعَتَانِ قَبْلَ صَلَاةِ الفَجْرِ -->
<div class="yn-card" id="fajr-sunnah-box">
  <h3 class="ar" style="font-size:1.3rem; margin:0 0 4px 0; text-align:right;">رَكْعَتَانِ قَبْلَ صَلَاةِ الفَجْرِ</h3>
  <div class="yn-row">
    <button class="yn-btn yes" id="btn-sunnah-yes" aria-pressed="false">نَعَمْ (Haa)</button>
    <button class="yn-btn no" id="btn-sunnah-no" aria-pressed="false">لَا (Maya)</button>
  </div>
</div>

<!-- هَلْ فَعَلْتُ عَادَةً سَيِّئَةً؟ -->
<div class="yn-card bad-card" id="bad-habit-box">
  <h3 class="ar" style="font-size:1.3rem; margin:0 0 4px 0; text-align:right;">هَلْ فَعَلْتُ عَادَةً سَيِّئَةً؟</h3>
  <div class="yn-row">
    <button class="yn-btn yes" id="btn-bad-yes" aria-pressed="false">نَعَمْ (Haa)</button>
    <button class="yn-btn no" id="btn-bad-no" aria-pressed="false">لَا (Maya)</button>
  </div>
</div>

<div class="prayers-card">
  <h3>Salaadaha Maanta</h3>
  <p class="q">Miyaa masjidka ku dukaday, mise ma ku dukan?</p>
  <div id="prayers"></div>
</div>

<div id="list"></div>
<h2>Isbuucan</h2>
<div class="week" id="week"></div>
<div id="wk"></div>
<h2>Taariikhda</h2>
<p id="sum"></p>
<div id="hist"></div>
<button class="reset" id="reset">Dib u bilow maanta</button>
</main>
<script>
var MAX=10000;
var ITEMS=[
{id:"istiqfar",n:"Istiqfaar",w:"Salaad kasta ka dib, hurdada ka hor",a:"أَسْتَغْفِرُ اللهَ الْعَظِيمَ الَّذِي لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ وَأَتُوبُ إِلَيْهِ"},
{id:"tawhid",n:"Towxiid",w:"Subaxda, fiidka, hurdada ka hor",a:"لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ"},
{id:"zunnun",n:"Ducada Dhun-Nuun",w:"Marka la dhibsado ama werwer jiro",a:"لَا إِلَهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ"},
{id:"tasbih",n:"Tasbiix",w:"Subaxda iyo fiidka",a:"سُبْحَانَ اللهِ وَبِحَمْدِهِ سُبْحَانَ اللهِ الْعَظِيمِ"},
{id:"tahlil",n:"Tahliil iyo Takbiir",w:"Maalinta oo dhan",a:"لَا إِلَهَ إِلَّا اللهُ، اللهُ أَكْبَرُ"},
{id:"salawat",n:"Salaad Nabiga ﷺ",w:"Maalinta oo dhan, gaar ahaan Jimce",a:"اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَآلِهِ وَسَلِّمْ"}
];
function ymd(d){return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")}
var today=ymd(new Date());
var KEY="adhkaar-"+today, GKEY="adhkaar-goals";
var state={}, goals={};
try{state=JSON.parse(localStorage.getItem(KEY)||"{}")||{}}catch(e){state={}}
try{goals=JSON.parse(localStorage.getItem(GKEY)||"{}")||{}}catch(e){goals={}}

function save(){var s={};ITEMS.forEach(function(it){s[it.id]=goalOf(it)});try{localStorage.setItem(KEY,JSON.stringify(state));localStorage.setItem("adhkaar-g-"+today,JSON.stringify(s))}catch(e){}
  queuePush("d-"+today,{s:JSON.parse(JSON.stringify(state)),g:s})}
function readJ(k){try{return JSON.parse(localStorage.getItem(k)||"null")}catch(e){return null}}
var selDay=today;
var PR=[
{id:"fajr",ar:"صَلَاةُ الفَجْر",n:"Subax (Fajr)"},
{id:"dhuhr",ar:"صَلَاةُ الظُّهْر",n:"Duhur"},
{id:"asr",ar:"صَلَاةُ العَصْر",n:"Casar"},
{id:"maghrib",ar:"صَلَاةُ المَغْرِب",n:"Maqrib"},
{id:"isha",ar:"صَلَاةُ العِشَاء",n:"Cishe"}
];
function setPrayer(id,v){
  state.prayers=state.prayers||{};
  if(state.prayers[id]===v)delete state.prayers[id]; else state.prayers[id]=v;
  save();render();
}
function prayerRows(c){
  var pr=c.prayers||{},rows='',any=false;
  PR.forEach(function(p){
    var v=pr[p.id];if(v)any=true;
    rows+='<div class="h'+(v==='m'?' ok':'')+'"><span>'+p.n+'</span><span>'+(v==='m'?'✓ Masjidka ku dukaday':(v==='n'?'Masjidka ma ku dukan':'–'))+'</span></div>';
  });
  return {rows:any?rows:'',any:any};
}
var DN=["Axad","Isniin","Talaado","Arbaco","Khamiis","Jimce","Sabti"];

function toggleQuran(){
  state.quranRead = !state.quranRead;
  save();
  render();
}

function setSunnahFajr(v){
  if(state.sunnahFajr === v) delete state.sunnahFajr;
  else state.sunnahFajr = v;
  save(); render();
}

function setBadHabit(v){
  if(state.badHabit === v) delete state.badHabit;
  else state.badHabit = v;
  save(); render();
}

function dayInfo(day){
  var c=readJ("adhkaar-"+day)||{},g=readJ("adhkaar-g-"+day)||{},tot=0,gs=0,rows="",all=true,any=false;
  ITEMS.forEach(function(it){
    if(Object.keys(g).length&&g[it.id]===undefined&&!c[it.id])return;
    var v=c[it.id]||0,gl=g[it.id]||goalOf(it),ok=v>=gl;
    tot+=v;gs+=gl;if(!ok)all=false;if(v)any=true;
    rows+='<div class="h'+(ok?' ok':'')+'"><span>'+it.n+'</span><span>'+(ok?'✓ ':'')+v.toLocaleString()+' / '+gl.toLocaleString()+'</span></div>';
  });
  var quranDone = c.quranRead;
  rows+='<div class="h'+(quranDone?' ok':'')+'"><span>Aqriska Qur\'aanka</span><span>'+(quranDone?'✓ La aqriyey':'Lama aqrin')+'</span></div>';
  if(quranDone) any=true;

  if(c.sunnahFajr){
    any=true;
    var sOk = c.sunnahFajr==='yes';
    rows+='<div class="h'+(sOk?' ok':'')+'"><span>رَكْعَتَانِ قَبْلَ صَلَاةِ الفَجْرِ</span><span>'+(sOk?'✓ نَعَمْ':'لَا')+'</span></div>';
  }
  if(c.badHabit){
    any=true;
    var bBad = c.badHabit==='yes';
    rows+='<div class="h'+(bBad?' bad':' ok')+'"><span>هَلْ فَعَلْتُ عَادَةً سَيِّئَةً؟</span><span>'+(bBad?'نَعَمْ ⚠️':'✓ لَا')+'</span></div>';
  }

  var pj=prayerRows(c);rows+=pj.rows;if(pj.any)any=true;
  return {tot:tot,gs:gs,rows:rows,all:all&&any,any:any,quranDone:quranDone};
}

function renderWeek(){
  var now=new Date(),start=new Date(now.getFullYear(),now.getMonth(),now.getDate()-((now.getDay()+1)%7));
  var box=document.getElementById("week");box.innerHTML="";
  for(var i=0;i<7;i++){
    (function(){
      var dt=new Date(start.getFullYear(),start.getMonth(),start.getDate()+i),key=ymd(dt),inf=dayInfo(key);
      var b=document.createElement("button");
      b.className="day"+(key===selDay?" sel":"")+(key>today?" fut":"");
      b.setAttribute("aria-label",DN[dt.getDay()]+" "+dt.getDate());
      b.innerHTML='<span>'+DN[dt.getDay()]+'</span><b>'+dt.getDate()+'</b><span>'+(inf.any?inf.tot.toLocaleString():'–')+(inf.all?' ✓':'')+'</span><span class="mb"><i style="width:'+(inf.gs?Math.min(100,inf.tot/inf.gs*100):0)+'%"></i></span>';
      b.onclick=function(){selDay=key;renderWeek()};
      box.appendChild(b);
      if(key===selDay){
        var t=dt.toLocaleDateString("so",{weekday:"long",day:"numeric",month:"long"});
        document.getElementById("wk").innerHTML='<div class="h"><b>'+t+'</b><b>'+inf.tot.toLocaleString()+'</b></div>'+(inf.any?inf.rows:'<p class="empty">Maalintan wax lama diiwaangelin.</p>');
      }
    })();
  }
}

function renderHist(){
  var days=[];
  try{for(var i=0;i<localStorage.length;i++){var k=localStorage.key(i);if(/^adhkaar-\d{4}-\d{2}-\d{2}$/.test(k))days.push(k.slice(8))}}catch(e){}
  days.sort().reverse();
  var box=document.getElementById("hist");box.innerHTML="";
  var used=0,full=0;
  days.forEach(function(day){
    var c=readJ("adhkaar-"+day)||{},g=readJ("adhkaar-g-"+day)||{},tot=0,rows="",all=true;
    ITEMS.forEach(function(it){
      if(Object.keys(g).length&&g[it.id]===undefined&&!c[it.id])return;
      var v=c[it.id]||0,gl=g[it.id]||goalOf(it);tot+=v;
      var ok=v>=gl;if(!ok)all=false;
      rows+='<div class="h'+(ok?' ok':'')+'"><span>'+it.n+'</span><span>'+(ok?'✓ ':'')+v.toLocaleString()+' / '+gl.toLocaleString()+'</span></div>';
    });
    var quranDone = c.quranRead;
    rows+='<div class="h'+(quranDone?' ok':'')+'"><span>Aqriska Qur\'aanka</span><span>'+(quranDone?'✓ La aqriyey':'Lama aqrin')+'</span></div>';
    
    if(c.sunnahFajr){
      var sOk = c.sunnahFajr==='yes';
      rows+='<div class="h'+(sOk?' ok':'')+'"><span>رَكْعَتَانِ قَبْلَ صَلَاةِ الفَجْرِ</span><span>'+(sOk?'✓ نَعَمْ':'لَا')+'</span></div>';
    }
    if(c.badHabit){
      var bBad = c.badHabit==='yes';
      rows+='<div class="h'+(bBad?' bad':' ok')+'"><span>هَلْ فَعَلْتُ عَادَةً سَيِّئَةً؟</span><span>'+(bBad?'نَعَمْ ⚠️':'✓ لَا')+'</span></div>';
    }

    var pj=prayerRows(c);rows+=pj.rows;
    if(tot===0 && !quranDone && !pj.any && !c.sunnahFajr && !c.badHabit)return;
    used++;if(all && quranDone)full++;
    var dt=new Date(day+"T12:00:00").toLocaleDateString("so",{weekday:"short",day:"numeric",month:"short",year:"numeric"});
    var el=document.createElement("details");
    el.innerHTML='<summary><span>'+(day===today?"Maanta · ":"")+dt+'</span><b>'+tot.toLocaleString()+(all && quranDone?' ✓':'')+'</b></summary>'+rows;
    box.appendChild(el);
  });
  document.getElementById("sum").textContent=used?("Maalmaha la diiwaangeliyay: "+used+" · Hadafyada oo dhan la gaaray: "+full):"";
  if(!used)box.innerHTML='<p class="empty">Weli wax lama keydin. Bilow tirinta maanta.</p>';
}

function saveGoals(){try{localStorage.setItem(GKEY,JSON.stringify(goals))}catch(e){}queuePush("goals",{g:JSON.parse(JSON.stringify(goals))})}
function goalOf(it){var g=parseInt(goals[it.id],10);return g>=1?Math.min(g,MAX):(it.d||100)}
document.getElementById("date").textContent=new Date().toLocaleDateString("so",{weekday:"long",day:"numeric",month:"long",year:"numeric"});

var list=document.getElementById("list");
ITEMS.forEach(function(it){
  var d=document.createElement("div");d.className="item";d.id="i-"+it.id;
  d.innerHTML='<div class="top"><span class="name">'+it.n+'</span><span class="cnt"></span></div>'+
  '<div class="ar">'+it.a+'</div><div class="time">'+it.w+'</div>'+
  '<div class="bar"><i></i></div>'+
  '<label class="goal">Hadafka: <input type="number" inputmode="numeric" min="1" max="'+MAX+'"> <span>(ilaa '+MAX.toLocaleString()+')</span></label>'+
  '<div class="row"><button class="main">+1</button><button data-k="10">+10</button><button data-k="100">+100</button><button data-k="-1" aria-label="Ka jar mid">−1</button></div>';
  list.appendChild(d);
  var inp=d.querySelector("input");inp.value=goalOf(it);
  inp.onchange=function(){var g=parseInt(inp.value,10);if(!(g>=1))g=100;if(g>MAX)g=MAX;goals[it.id]=g;inp.value=g;saveGoals();if(state[it.id])save();render()};
  d.querySelector(".main").onclick=function(){add(it,1)};
  [].forEach.call(d.querySelectorAll("button[data-k]"),function(b){b.onclick=function(){add(it,parseInt(b.dataset.k,10))}});
});

var pbox=document.getElementById("prayers");
PR.forEach(function(p){
  var d=document.createElement("div");d.className="prayer";d.id="p-"+p.id;
  d.innerHTML='<div class="pname"><span class="ar">'+p.ar+'</span><span class="so">'+p.n+'</span></div>'+
  '<div class="prow"><button class="pbtn m" data-v="m" aria-pressed="false">🕌 Masjidka ku dukaday</button>'+
  '<button class="pbtn n" data-v="n" aria-pressed="false">Ma ku dukan</button></div>';
  pbox.appendChild(d);
  [].forEach.call(d.querySelectorAll(".pbtn"),function(b){b.onclick=function(){setPrayer(p.id,b.dataset.v)}});
});

document.getElementById("btn-sunnah-yes").onclick = function(){ setSunnahFajr("yes"); };
document.getElementById("btn-sunnah-no").onclick = function(){ setSunnahFajr("no"); };

