/* ===== Waafajinta qalabka ===== */
var sync={col:null,q:{},busy:false,timer:null,first:true};
function setSyncMsg(t){var e=document.getElementById("syncmsg");if(e)e.textContent=t}
function queuePush(key,data){
  if(!sync||!sync.col)return;
  sync.q[key]=data;clearTimeout(sync.timer);sync.timer=setTimeout(flush,500);
}
async function flush(){
  if(sync.busy||!sync.col)return;
  sync.busy=true;var bad=false;
  try{
    while(Object.keys(sync.q)[0]){
      var k=Object.keys(sync.q)[0],v=sync.q[k];delete sync.q[k];
      try{await sync.col.doc(k).set(v)}catch(e){bad=true}
    }
  }finally{sync.busy=false}
  setSyncMsg(bad?"⚠️ Waa la waayay in la waafajiyo, waan isku dayi doonaa mar kale":"☁️ La waafajiyay");
}
function refreshInputs(){
  ITEMS.forEach(function(it){
    var inp=document.querySelector("#i-"+it.id+" input");
    if(inp&&document.activeElement!==inp)inp.value=goalOf(it);
  });
}
function onRemote(qs){
  var have={};
  qs.docs.forEach(function(ds){
    var id=ds.id,d=ds.data();have[id]=1;if(!d)return;
    try{
      if(id==="goals"){
        goals=d.g||{};localStorage.setItem(GKEY,JSON.stringify(goals));
      }else if(id.indexOf("d-")===0){
        var day=id.slice(2);
        if(day===today&&sync.q[id])return;
        localStorage.setItem("adhkaar-"+day,JSON.stringify(d.s||{}));
        localStorage.setItem("adhkaar-g-"+day,JSON.stringify(d.g||{}));
        if(day===today)state=d.s||{};
      }
    }catch(e){}
  });
  if(sync.first){
    sync.first=false;
    try{
      for(var i=0;i<localStorage.length;i++){
        var k=localStorage.key(i);
        if(/^adhkaar-\d{4}-\d{2}-\d{2}$/.test(k)){
          var day=k.slice(8);
          if(!have["d-"+day])queuePush("d-"+day,{s:readJ(k)||{},g:readJ("adhkaar-g-"+day)||{}});
        }
      }
      if(!have.goals&&Object.keys(goals).length)queuePush("goals",{g:JSON.parse(JSON.stringify(goals))});
    }catch(e){}
  }
  refreshInputs();render();
  if(!Object.keys(sync.q).length)setSyncMsg("☁️ La waafajiyay");
}
(async function(){
  try{
    if(!window.claude||!window.claude.use){setSyncMsg("Xogta waxay ku jirtaa qalabkan kaliya");return}
    var db=await window.claude.use("db"),user=await window.claude.use("user");
    if(!db||!user){setSyncMsg("Xogta waxay ku jirtaa qalabkan kaliya (gal akoonkaaga si loo waafajiyo)");return}
    var uid=await user.id();
    if(!uid){setSyncMsg("Xogta waxay ku jirtaa qalabkan kaliya (gal akoonkaaga si loo waafajiyo)");return}
    sync.col=db.collection("data/users/"+uid);
    setSyncMsg("☁️ Waa la waafajinayaa…");
    sync.col.onSnapshot(onRemote,function(){setSyncMsg("⚠️ Waafajintu way istaagtay, xogta qalabkan ayaa la kaydiyay")});
  }catch(e){setSyncMsg("Xogta waxay ku jirtaa qalabkan kaliya")}
})();

